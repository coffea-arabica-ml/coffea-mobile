# "mock" (padrão) usa o serviço simulado em src/api/mock — não precisa do coffea-backend.
# "http" envia a foto para o coffea-backend em EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_API_MODE=mock

# Só usado no modo "http". Use o IP local da máquina que roda o coffea-backend (ex.: 192.168.0.15),
# descoberto com "ipconfig" no Windows. NÃO funciona com "localhost": o celular é outro aparelho.
EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:8000
